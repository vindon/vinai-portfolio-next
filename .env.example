# Cloudflare Web Analytics beacon token — Cloudflare dashboard > Analytics & Logs
# > Web Analytics > Add a site > copy the token from the generated snippet.
# Leave unset to disable analytics and the cookie banner entirely.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Full production URL, used for canonical links, sitemap, robots.txt, and
# Open Graph tags. Defaults to a placeholder if unset.
NEXT_PUBLIC_SITE_URL=https://firstbloc.in

# Gates the entire homepage behind a "Coming soon" placeholder (see
# lib/site.ts's isComingSoon) — case/whitespace-tolerant, but the literal
# word "true" is what turns it on. Set only on Vercel's Production
# environment; leave unset in Preview/Development so staging always shows
# the real site.
COMING_SOON=
